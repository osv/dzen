#!/usr/bin/env bash

set -euo pipefail

OPTS=(
    -bg "#111111"
    -fg "grey70"
    -p
    -l 30
    -b "1,#5FBF77"
    -pad "5,20"
    -e "onstart=uncollapse,scrollhome,grabkeys;\
button5=scrolldown;\
key_Down=scrolldown;\
button4=scrollup;\
key_Up=scrollup;\
key_Page_Down=scrolldown:30;\
key_Page_Up=scrollup:30;\
key_KP_Next=scrolldown:30;\
key_KP_Prior=scrollup:30;\
key_Escape=exit;\
button3=exit;\
entertitle=grabkeys;\
enterslave=grabkeys"
)

BINDIR='@bindir@'
DOCDIR='@docdir@'
SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)

find_dzen2() {
    if [ -x ./src/dzen2 ]; then
        # Local development
        echo "./src/dzen2"
    elif [ -x "$SCRIPT_DIR/src/dzen2" ]; then
        echo "$SCRIPT_DIR/src/dzen2"
    elif [ -x "$BINDIR/dzen2" ]; then
        # Installed binary
        echo "$BINDIR/dzen2"
    else
        echo ""
    fi
}

find_readme() {
    if [ -f README.dzen ]; then
        # Local development
        echo "README.dzen"
    elif [ -f "$SCRIPT_DIR/README.dzen" ]; then
        echo "$SCRIPT_DIR/README.dzen"
    elif [ -f "$DOCDIR/README.dzen" ]; then
        # Installed documentation
        echo "$DOCDIR/README.dzen"
    else
        echo ""
    fi
}

DZEN2_BIN=$(find_dzen2)
README_FILE=$(find_readme)

if [ -x "$DZEN2_BIN" ]; then
    if [ -f "$README_FILE" ]; then
        # Resolve relative icon paths against the documentation, including after install.
        README_DIR=$(dirname "$README_FILE")
        README_NAME=$(basename "$README_FILE")
        DZEN2_BIN=$(realpath "$DZEN2_BIN")
        PROCESSOR="$README_DIR/build-aux/generate-docs.awk"
        [[ -f "$PROCESSOR" ]] || PROCESSOR="$README_DIR/generate-docs.awk"
        if [[ ! -f "$PROCESSOR" ]]; then
            echo "Error: generate-docs.awk not found beside README.dzen." >&2
            exit 1
        fi
        PROCESSOR=$(realpath "$PROCESSOR")
        cd "$README_DIR" || exit 1
        (
            echo "^fg(#323232)^bg(#5FBF77) Documentation (use: scrollwheel, arrow keys, PgUP/PgDown to scroll. Escape or right mouse button to quit)";
            awk -v mode=dzen -f "$PROCESSOR" "$README_NAME"
        ) | "$DZEN2_BIN" "${OPTS[@]}"
    else
        echo "Error: README.dzen not found. Please ensure the file is available."
        exit 1
    fi
else
    echo "Error: dzen2 binary not found. Please build the project by running 'make' or ensure dzen2 is installed."
    exit 1
fi
